<?xml version="1.0"?>
<robot name="restaurant_waiter">

  <material name="skin">
    <color rgba="0.68 0.48 0.34 1"/>
  </material>

  <material name="shirt">
    <color rgba="0.94 0.94 0.94 1"/>
  </material>

  <material name="apron">
    <color rgba="0.05 0.06 0.07 1"/>
  </material>

  <material name="pants">
    <color rgba="0.08 0.09 0.11 1"/>
  </material>

  <material name="tray">
    <color rgba="0.25 0.26 0.28 1"/>
  </material>

  <link name="waiter">

    <!-- legs -->
    <visual>
      <origin xyz="0 0.10 0.34"/>
      <geometry><cylinder radius="0.075" length="0.68"/></geometry>
      <material name="pants"/>
    </visual>

    <visual>
      <origin xyz="0 -0.10 0.34"/>
      <geometry><cylinder radius="0.075" length="0.68"/></geometry>
      <material name="pants"/>
    </visual>

    <!-- torso -->
    <visual>
      <origin xyz="0 0 0.95"/>
      <geometry><box size="0.34 0.25 0.58"/></geometry>
      <material name="shirt"/>
    </visual>

    <!-- apron -->
    <visual>
      <origin xyz="0.18 0 0.88"/>
      <geometry><box size="0.025 0.22 0.40"/></geometry>
      <material name="apron"/>
    </visual>

    <!-- head -->
    <visual>
      <origin xyz="0 0 1.39"/>
      <geometry><sphere radius="0.17"/></geometry>
      <material name="skin"/>
    </visual>

    <!-- arm holding tray -->
    <visual>
      <origin xyz="0.10 0.28 1.03" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.42"/></geometry>
      <material name="skin"/>
    </visual>

    <!-- serving tray -->
    <visual>
      <origin xyz="0.13 0.46 1.08"/>
      <geometry><box size="0.38 0.28 0.035"/></geometry>
      <material name="tray"/>
    </visual>

    <!-- simple physical body -->
    <collision>
      <origin xyz="0 0 0.88"/>
      <geometry><box size="0.42 0.34 1.40"/></geometry>
    </collision>

  </link>

</robot>
