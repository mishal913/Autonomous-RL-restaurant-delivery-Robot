<?xml version="1.0"?>
<robot name="restaurant_table_set">
  <material name="wood"><color rgba="0.38 0.18 0.08 1"/></material>
  <material name="wood_light"><color rgba="0.58 0.30 0.13 1"/></material>
  <material name="seat"><color rgba="0.12 0.25 0.31 1"/></material>
  <material name="metal"><color rgba="0.18 0.19 0.20 1"/></material>

  <link name="base_link">
    <!-- Larger tabletop, kept inside the existing navigation footprint. -->
    <visual>
      <origin xyz="0 0 0.78"/>
      <geometry><box size="1.62 0.94 0.12"/></geometry>
      <material name="wood_light"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.78"/>
      <geometry><box size="1.62 0.94 0.12"/></geometry>
    </collision>

    <!-- Four table legs -->
    <visual><origin xyz="0.65 0.31 0.39"/><geometry><box size="0.09 0.09 0.72"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.65 -0.31 0.39"/><geometry><box size="0.09 0.09 0.72"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="-0.65 0.31 0.39"/><geometry><box size="0.09 0.09 0.72"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="-0.65 -0.31 0.39"/><geometry><box size="0.09 0.09 0.72"/></geometry><material name="metal"/></visual>

    <!-- North chair -->
    <visual><origin xyz="0 0.92 0.45"/><geometry><box size="0.58 0.50 0.11"/></geometry><material name="seat"/></visual>
    <visual><origin xyz="0 1.13 0.72"/><geometry><box size="0.58 0.11 0.55"/></geometry><material name="seat"/></visual>
    <visual><origin xyz="0.21 0.92 0.23"/><geometry><box size="0.065 0.065 0.40"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="-0.21 0.92 0.23"/><geometry><box size="0.065 0.065 0.40"/></geometry><material name="metal"/></visual>
    <collision><origin xyz="0 0.94 0.43"/><geometry><box size="0.60 0.60 0.76"/></geometry></collision>

    <!-- South chair -->
    <visual><origin xyz="0 -0.92 0.45"/><geometry><box size="0.58 0.50 0.11"/></geometry><material name="seat"/></visual>
    <visual><origin xyz="0 -1.13 0.72"/><geometry><box size="0.58 0.11 0.55"/></geometry><material name="seat"/></visual>
    <visual><origin xyz="0.21 -0.92 0.23"/><geometry><box size="0.065 0.065 0.40"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="-0.21 -0.92 0.23"/><geometry><box size="0.065 0.065 0.40"/></geometry><material name="metal"/></visual>
    <collision><origin xyz="0 -0.94 0.43"/><geometry><box size="0.60 0.60 0.76"/></geometry></collision>

    <inertial>
      <origin xyz="0 0 0.52"/>
      <mass value="32"/>
      <inertia ixx="9" ixy="0" ixz="0" iyy="10" iyz="0" izz="8"/>
    </inertial>
  </link>
</robot>
