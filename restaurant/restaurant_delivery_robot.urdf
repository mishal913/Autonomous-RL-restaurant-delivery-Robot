<?xml version="1.0"?>
<robot name="restaurant_delivery_robot">
  <material name="body"><color rgba="0.08 0.24 0.48 1"/></material>
  <material name="body_light"><color rgba="0.70 0.82 0.90 1"/></material>
  <material name="tray"><color rgba="0.22 0.24 0.27 1"/></material>
  <material name="rail"><color rgba="0.86 0.58 0.12 1"/></material>
  <material name="screen"><color rgba="0.05 0.55 0.75 1"/></material>
  <material name="sensor"><color rgba="0.04 0.04 0.05 1"/></material>
  <material name="wheel"><color rgba="0.035 0.035 0.04 1"/></material>

  <link name="base_link">
    <!-- Low mobile chassis; physics footprint remains model-compatible. -->
    <visual><origin xyz="0 0 0.25"/><geometry><box size="1.20 0.80 0.30"/></geometry><material name="body"/></visual>
    <visual><origin xyz="0.49 0 0.35"/><geometry><box size="0.22 0.70 0.18"/></geometry><material name="body_light"/></visual>
    <visual><origin xyz="-0.34 0 0.67"/><geometry><box size="0.18 0.52 0.72"/></geometry><material name="body"/></visual>

    <!-- Lower serving tray and safety lips. -->
    <visual><origin xyz="0.02 0 0.63"/><geometry><box size="0.98 0.66 0.055"/></geometry><material name="tray"/></visual>
    <visual><origin xyz="0.02 0.32 0.69"/><geometry><box size="0.98 0.035 0.12"/></geometry><material name="rail"/></visual>
    <visual><origin xyz="0.02 -0.32 0.69"/><geometry><box size="0.98 0.035 0.12"/></geometry><material name="rail"/></visual>
    <visual><origin xyz="-0.45 0 0.69"/><geometry><box size="0.035 0.64 0.12"/></geometry><material name="rail"/></visual>

    <!-- Upper serving tray and safety lips. -->
    <visual><origin xyz="0.02 0 1.03"/><geometry><box size="0.98 0.66 0.055"/></geometry><material name="tray"/></visual>
    <visual><origin xyz="0.02 0.32 1.09"/><geometry><box size="0.98 0.035 0.12"/></geometry><material name="rail"/></visual>
    <visual><origin xyz="0.02 -0.32 1.09"/><geometry><box size="0.98 0.035 0.12"/></geometry><material name="rail"/></visual>
    <visual><origin xyz="-0.45 0 1.09"/><geometry><box size="0.035 0.64 0.12"/></geometry><material name="rail"/></visual>

    <!-- Front status screen and top LiDAR. -->
    <visual><origin xyz="0.585 0 0.82"/><geometry><box size="0.035 0.35 0.23"/></geometry><material name="screen"/></visual>
    <visual><origin xyz="-0.20 0 1.23"/><geometry><cylinder radius="0.105" length="0.10"/></geometry><material name="sensor"/></visual>

    <collision><origin xyz="0 0 0.25"/><geometry><box size="1.20 0.80 0.30"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.30"/>
      <mass value="8.0"/>
      <inertia ixx="0.48" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.2"/>
    </inertial>
  </link>

  <link name="front_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry><material name="wheel"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.42 0.46 0.18"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0"/>
  </joint>

  <link name="front_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry><material name="wheel"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.42 -0.46 0.18"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry><material name="wheel"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.42 0.46 0.18"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry><material name="wheel"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.18" length="0.12"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.42 -0.46 0.18"/><axis xyz="0 1 0"/><dynamics damping="0.1" friction="0"/>
  </joint>
</robot>
