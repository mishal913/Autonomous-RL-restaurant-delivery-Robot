<?xml version="1.0"?>
<robot name="delivery_vehicle_obstacle">
  <material name="body"><color rgba="0.80 0.18 0.12 1"/></material>
  <material name="glass"><color rgba="0.25 0.55 0.70 1"/></material>
  <material name="wheel"><color rgba="0.08 0.08 0.08 1"/></material>

  <link name="vehicle">
    <visual>
      <origin xyz="0 0 0.32"/>
      <geometry><box size="1.45 0.82 0.46"/></geometry>
      <material name="body"/>
    </visual>

    <visual>
      <origin xyz="0.20 0 0.66"/>
      <geometry><box size="0.68 0.72 0.34"/></geometry>
      <material name="glass"/>
    </visual>

    <visual>
      <origin xyz="-0.48 0 0.51"/>
      <geometry><box size="0.34 0.72 0.18"/></geometry>
      <material name="body"/>
    </visual>

    <visual>
      <origin xyz="-0.48 -0.46 0.20" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.12"/></geometry>
      <material name="wheel"/>
    </visual>
    <visual>
      <origin xyz="-0.48 0.46 0.20" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.12"/></geometry>
      <material name="wheel"/>
    </visual>
    <visual>
      <origin xyz="0.48 -0.46 0.20" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.12"/></geometry>
      <material name="wheel"/>
    </visual>
    <visual>
      <origin xyz="0.48 0.46 0.20" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.18" length="0.12"/></geometry>
      <material name="wheel"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.38"/>
      <geometry><box size="1.55 0.95 0.76"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.38"/>
      <mass value="50"/>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
    </inertial>
  </link>
</robot>
