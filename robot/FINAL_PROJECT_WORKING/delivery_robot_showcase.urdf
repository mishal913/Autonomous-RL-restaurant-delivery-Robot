<?xml version="1.0"?>
<robot name="delivery_showcase_robot">

    <!-- Materials -->
    <material name="body_blue">
        <color rgba="0.10 0.35 0.75 1"/>
    </material>
    <material name="cargo_light">
        <color rgba="0.88 0.90 0.94 1"/>
    </material>
    <material name="sensor_dark">
        <color rgba="0.08 0.08 0.10 1"/>
    </material>
    <material name="wheel_dark">
        <color rgba="0.05 0.05 0.05 1"/>
    </material>

    <!-- ===================================================== -->
    <!-- BASE / CHASSIS                                        -->
    <!-- Physics kept compatible with original robot.          -->
    <!-- ===================================================== -->

    <link name="base_link">

        <!-- Lower chassis -->
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="1.2 0.8 0.3"/>
            </geometry>
            <material name="body_blue"/>
        </visual>

        <!-- Delivery cargo compartment -->
        <visual>
            <origin xyz="-0.08 0 0.52" rpy="0 0 0"/>
            <geometry>
                <box size="0.78 0.64 0.34"/>
            </geometry>
            <material name="cargo_light"/>
        </visual>

        <!-- Front sloped-looking bumper block -->
        <visual>
            <origin xyz="0.48 0 0.39" rpy="0 0 0"/>
            <geometry>
                <box size="0.25 0.66 0.18"/>
            </geometry>
            <material name="body_blue"/>
        </visual>

        <!-- LiDAR / sensor mast -->
        <visual>
            <origin xyz="0.20 0 0.76" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.11" length="0.10"/>
            </geometry>
            <material name="sensor_dark"/>
        </visual>

        <!-- Small front sensor face -->
        <visual>
            <origin xyz="0.61 0 0.34" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.24 0.10"/>
            </geometry>
            <material name="sensor_dark"/>
        </visual>

        <!-- IMPORTANT: collision footprint remains original -->
        <collision>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="1.2 0.8 0.3"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.25"/>
            <mass value="8.0"/>
            <inertia
                ixx="0.48"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.2"/>
        </inertial>

    </link>


    <!-- ===================================================== -->
    <!-- FRONT LEFT WHEEL                                      -->
    <!-- ===================================================== -->

    <link name="front_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
            <material name="wheel_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.008"
                ixy="0"
                ixz="0"
                iyy="0.008"
                iyz="0"
                izz="0.008"/>
        </inertial>
    </link>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.42 0.46 0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.0"/>
    </joint>


    <!-- FRONT RIGHT WHEEL -->
    <link name="front_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
            <material name="wheel_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.008"
                ixy="0"
                ixz="0"
                iyy="0.008"
                iyz="0"
                izz="0.008"/>
        </inertial>
    </link>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.42 -0.46 0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.0"/>
    </joint>


    <!-- REAR LEFT WHEEL -->
    <link name="rear_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
            <material name="wheel_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.008"
                ixy="0"
                ixz="0"
                iyy="0.008"
                iyz="0"
                izz="0.008"/>
        </inertial>
    </link>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.42 0.46 0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.0"/>
    </joint>


    <!-- REAR RIGHT WHEEL -->
    <link name="rear_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
            <material name="wheel_dark"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.18" length="0.12"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.008"
                ixy="0"
                ixz="0"
                iyy="0.008"
                iyz="0"
                izz="0.008"/>
        </inertial>
    </link>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.42 -0.46 0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.0"/>
    </joint>

</robot>
